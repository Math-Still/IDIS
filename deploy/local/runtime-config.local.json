{
  "apiBaseUrl": "http://127.0.0.1:8001",
  "wsBaseUrl": "ws://127.0.0.1:8001/ws",
  "environment": "development",
  "siteId": "local-docker",
  "backendApiVersion": "v1",
  "dataMode": "backend",
  "realtime": {
    "staleAfterMs": 10000,
    "badAfterMs": 60000,
    "reconnectBaseMs": 1000,
    "reconnectMaxMs": 30000,
    "reconnectJitterRatio": 0.2,
    "commandTimeoutMs": 15000,
    "stableConnectionMs": 10000,
    "messageSilenceReconnectMs": 45000
  },
  "deployment": {
    "platformTarget": "windows-docker",
    "platformLabel": "Windows Docker Desktop",
    "hardwareProfile": "local-development",
    "deploymentId": "local-8001"
  },
  "benchmark": {
    "enabled": true,
    "pingPath": "benchmark/ping",
    "iterations": 30,
    "warmupIterations": 3,
    "intervalMs": 100,
    "requestTimeoutMs": 5000
  },
  "faultInjection": {
    "enabled": true,
    "allowInFactory": false
  },
  "transport": {
    "httpRequestTimeoutMs": 8000,
    "maxJsonResponseBytes": 8388608,
    "maxRealtimeMessageBytes": 524288
  }
}

